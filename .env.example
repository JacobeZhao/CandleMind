
CANDLEMIND_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Retained for compatibility with older deployments. Current cloud providers use fixed
# official HTTPS hosts; custom/LiteLLM/Ollama accept loopback and RFC1918 addresses.
CANDLEMIND_AI_BASE_URL_HOSTS=

# Host paths mounted by docker-compose.yml. Runtime state includes the database,
# encryption key, and strategies/ paper-state files; keep them together.
CANDLEMIND_DATA_ROOT=G:/CandleMind/CandleMind_data
CANDLEMIND_RUNTIME_ROOT=G:/CandleMind/CandleMind_data/runtime/app

# Direct host execution uses these paths.
MARKET_DATA_DIR=G:/CandleMind/CandleMind_data
DATA_DIR=G:/CandleMind/CandleMind_data/runtime/app

# Maximum automatic and manual market-agent analyses per UTC day. The default
# leaves a small allowance above the 288 scheduled 5-minute analyses.
CANDLEMIND_MARKET_AGENT_DAILY_LIMIT=300
